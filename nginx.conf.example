# Configuración de Nginx Reverse Proxy para Control de Personal
# Colocar en: /etc/nginx/sites-available/controlpersonal
# Activar con: ln -s /etc/nginx/sites-available/controlpersonal /etc/nginx/sites-enabled/
# Certificado SSL gratuito con: certbot --nginx -d tu-dominio.com

server {
    listen 80;
    server_name tu-dominio.com www.tu-dominio.com; # Reemplazar con tu dominio o la IP del VPS

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
