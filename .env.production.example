# ===================================================
# CONFIGURACIÓN DE PRODUCCIÓN - DONWEB VPS
# ===================================================

# Credenciales de la Base de Datos PostgreSQL en el VPS
POSTGRES_USER=turnomaster
POSTGRES_PASSWORD=DefinirUnaContrasenaSegura2026!
POSTGRES_DB=turnomaster_db

# Puerto de la aplicación (por defecto 3000, o 80 si no usas Nginx)
APP_PORT=3000

# Clave secreta para generación de tokens de autenticación (JWT)
# Puedes generar una con: openssl rand -base64 32
JWT_SECRET=reemplazar_con_un_string_largo_y_seguro_de_al_menos_32_caracteres

# Las URLs de Prisma se configuran automáticamente en docker-compose.yml
# DATABASE_URL=postgresql://turnomaster:PASSWORD@db:5432/turnomaster_db?schema=public
# DIRECT_URL=postgresql://turnomaster:PASSWORD@db:5432/turnomaster_db?schema=public
